<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted servers are usually plain http on the LAN, so cleartext must be
     allowed. Users on a domain with TLS still work (https is always permitted). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
